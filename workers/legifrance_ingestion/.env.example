# API Dragonfly
DRAGONFLY_API_BASE_URL=http://localhost:8001
DRAGONFLY_API_KEY=DGY_API.xxx.yyy

# Datasource cible
DRAGONFLY_DATASOURCE_NAME=legifrance

# Répertoire local de travail
LEGI_WORKDIR=/tmp/legifrance_ingestion

# HTTP
LEGI_HTTP_TIMEOUT=60
LEGI_HTTP_MAX_RETRIES=3
LEGI_HTTP_RETRY_BACKOFF=2

# Logging
LEGI_LOG_LEVEL=INFO

# Corpus activés
LEGI_ENABLE_LEGI=true
LEGI_ENABLE_JORF=true

# URLs DILA
DILA_BASE_URL=https://echanges.dila.gouv.fr/OPENDATA
DILA_LEGI_URL=https://echanges.dila.gouv.fr/OPENDATA/LEGI/
DILA_JORF_URL=https://echanges.dila.gouv.fr/OPENDATA/JORF/
